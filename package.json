{
  "name": "local-llm-desktop",
  "version": "0.1.0",
  "author": "Cyril Grossenbacher",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/localllm/local-llm-desktop",
  "description": "Local LLM desktop app with Hugging Face, RAG wiki, and optional LoRA training",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-preload-api.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:intellij-plugin": "node scripts/build-intellij-plugin.mjs",
    "prepreview": "node scripts/ensure-preload-api.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist:zip": "node scripts/package-zip.mjs",
    "dist:installer": "node scripts/package-installer.mjs",
    "dist:linux": "node scripts/package-linux.mjs",
    "dist:linux:cpu": "node scripts/package-linux.mjs --cpu",
    "dist:linux:rpi5": "node scripts/package-linux.mjs --rpi5",
    "dist:linux:podman": "node scripts/package-linux-podman.mjs",
    "dist:linux:cpu:podman": "node scripts/package-linux-podman.mjs --cpu",
    "dist:linux:rpi5:podman": "node scripts/package-linux-podman.mjs --rpi5",
    "icons": "node scripts/generate-icons.mjs",
    "prewebsite:preview": "npm run website:assets",
    "website:preview": "npx --yes serve website -l 4174",
    "website:assets": "node scripts/generate-website-assets.mjs",
    "claude:bridge": "node scripts/claude-bridge-mcp-stdio.mjs",
    "claude:bridge:ps1": "powershell -ExecutionPolicy Bypass -File scripts/claude-bridge-mcp.ps1",
    "claude:bridge:legacy-wrapper": "node scripts/claude-code-bridge-wrapper.mjs",
    "claude:bridge:legacy-wrapper:ps1": "powershell -ExecutionPolicy Bypass -File scripts/claude-bridge.ps1",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@asciidoctor/core": "^3.0.4",
    "@electron-toolkit/utils": "^3.0.0",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@huggingface/hub": "^1.0.1",
    "archiver": "^7.0.1",
    "archiver-utils": "^5.0.2",
    "better-sqlite3": "^11.7.0",
    "compress-commons": "^6.0.2",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.5",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.8.3",
    "graphology": "^0.26.0",
    "katex": "^0.16.45",
    "marked": "^18.0.2",
    "mermaid": "^11.15.0",
    "pdf-parse": "^2.4.5",
    "sigma": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/d3-force": "^3.0.10",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "png2icons": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^3.0.5"
  }
}
